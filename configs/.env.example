# Скопируйте в configs/.env и заполните. Файл .env в git не попадает.

# --- Приложение ---
APP_NAME=Vacancy Collector
APP_DEBUG=false
# Внешний адрес (нужен для OAuth Google), без слэша в конце
APP_PUBLIC_URL=https://jobs.example.com
APP_TIMEZONE=Asia/Yekaterinburg

# --- Вход в интерфейс ---
# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=change-me
AUTH_ADMIN_USERNAME=admin
# Хеш пароля: python scripts/hash_password.py
AUTH_ADMIN_PASSWORD_HASH=
# true, если сайт работает по HTTPS
AUTH_COOKIE_SECURE=true
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# --- PostgreSQL (в docker-compose хост — postgres) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=collector
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vacancy_collector

# --- Celery / Redis (в docker-compose хост — redis) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Ежедневный сбор в 10:00 по APP_TIMEZONE
CELERY_COLLECT_HOUR=10
CELERY_COLLECT_MINUTE=0
CELERY_EXPORT_AFTER_COLLECT=true

# --- API hh.ru ---
# Обязательно: название приложения и ваша почта
HH_USER_AGENT=VacancyCollector/1.0 (you@example.com)
# ОБЯЗАТЕЛЬНО: токен приложения. Поиск вакансий в API hh требует авторизации приложения.
# 1) зарегистрируйте приложение на https://dev.hh.ru
# 2) один раз получите токен приложения и скопируйте его из https://dev.hh.ru/admin
# Токен постоянный (без refresh). Если выпустить новый — старый отзывается, обновите здесь.
HH_APP_TOKEN=
HH_REQUEST_DELAY_SEC=1.5
HH_PER_PAGE=100
HH_MAX_PAGES=5
# 1 = вакансии со вчерашнего дня
HH_PERIOD_DAYS=1
HH_EXCLUDE_WORDS=senior,lead,тимлид,team lead,architect,архитектор,java,golang,c#,.net,php,1с,1c

# --- Google Диск (OAuth-клиент «Веб-приложение») ---
# Redirect URI в Google Cloud Console: {APP_PUBLIC_URL}/drive/callback
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# ID папки на Диске (из адреса папки). Пусто — файл в корне Диска.
GDRIVE_FOLDER_ID=
GDRIVE_EXPORT_FILE_NAME=hh_вакансии.xlsx
# drive.file — доступ только к файлам приложения. Чтобы класть файл в СВОЮ существующую папку,
# укажите https://www.googleapis.com/auth/drive
GDRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
